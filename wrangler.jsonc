// Title: wrangler.jsonc
// Author: Hali Sarah Parsons
// Date: 2026-10-19
// Modified By: Claude
// Description: Hosts iqproductionz.com as a static site on Cloudflare Workers.
//   No script needed: "assets" alone tells the Worker to serve the repo's files.
//   WHY "." not "./dist": the site files live in the repo root; serving straight
//   from there removes the build step that was supposed to create dist.
{
  "name": "iqproductionz",
  "compatibility_date": "2024-01-01",
  "assets": {
    "directory": ".",
    // WHY 404-page: a missing URL shows your 404.html (if you have one)
    // instead of a blank Cloudflare error.
    "not_found_handling": "404-page"
  }
}
